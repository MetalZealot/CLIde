{
  "name": "@cloudcli-ai/cloudcli",
  "version": "1.37.0",
  "private": true,
  "description": "A self-hosted web app for driving coding agents from your phone or a desktop browser",
  "type": "module",
  "main": "dist-server/server/index.js",
  "bin": {
    "cloudcli": "dist-server/server/modules/cli/cli.js"
  },
  "homepage": "https://github.com/MetalZealot/CLIde#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetalZealot/CLIde.git"
  },
  "bugs": {
    "url": "https://github.com/MetalZealot/CLIde/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:dev\" \"npm run client\"",
    "server": "node dist-server/server/index.js",
    "server:dev": "tsx --tsconfig server/tsconfig.json server/index.ts",
    "server:dev-watch": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "postbuild:client": "node scripts/write-release-state.mjs client",
    "prebuild:server": "node -e \"require('node:fs').rmSync('dist-server.next', { recursive: true, force: true })\"",
    "build:server": "tsc -p server/tsconfig.json --incremental false && tsc-alias -p server/tsconfig.json",
    "postbuild:server": "node scripts/promote-dist-server.mjs && node scripts/write-release-state.mjs server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json",
    "test": "npm run check:tests && npm run test:server && npm run test:client",
    "test:server": "tsx --tsconfig server/tsconfig.json --import ./scripts/isolate-test-database.mjs --test \"server/**/*.test.ts\" \"server/**/*.test.js\"",
    "test:client": "tsx --tsconfig tsconfig.json --import ./src/test/setup-client-env.ts --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:server:one": "tsx --tsconfig server/tsconfig.json --import ./scripts/isolate-test-database.mjs --test",
    "test:client:one": "tsx --tsconfig tsconfig.json --import ./src/test/setup-client-env.ts --test",
    "test:codex": "node scripts/verify-codex-integration.mjs",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslintcache src/ server/",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslintcache src/ server/ --fix",
    "start": "npm run build && npm run server",
    "postinstall": "node scripts/fix-node-pty.js",
    "prepare": "husky && node scripts/write-release-state.mjs dependencies",
    "update:platform": "./update-platform.sh",
    "check:docs": "node scripts/check-docs.mjs",
    "check:providers": "node scripts/check-providers.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:tests": "node scripts/check-tests.mjs",
    "docs:dashboard": "node scripts/build-project-dashboard.mjs",
    "test:docs:dashboard": "node --test scripts/build-project-dashboard.test.mjs",
    "bench:chat-history": "node scripts/bench-chat-history.mjs",
    "bench:chat-history:browser": "tsx --tsconfig server/tsconfig.json scripts/chat-history/browser-server.ts"
  },
  "keywords": [
    "claude code",
    "claude-code",
    "claude-code-ui",
    "cloudcli",
    "codex",
    "cursor",
    "cursor-cli",
    "anthropic",
    "openai",
    "google",
    "coding-agent",
    "web-ui",
    "ui",
    "mobile IDE"
  ],
  "author": "CloudCLI UI Contributors",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.11.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.0",
    "@openai/codex-sdk": "0.153.4",
    "@playwright/mcp": "0.0.80",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.16",
    "@uiw/react-codemirror": "^4.23.13",
    "@vscode/ripgrep": "^1.17.1",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "cross-spawn": "^7.0.3",
    "dompurify": "^3.4.7",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "ignore": "^7.0.6",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.2.0-beta.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-error-boundary": "^4.1.2",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.1",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.3.1",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/cross-spawn": "^6.0.6",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.3",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.3.2",
    "node-gyp": "^10.0.0",
    "playwright": "1.63.0-alpha-2026-08-31",
    "postcss": "^8.4.32",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.0.4"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "server/**/*.{js,ts}": "eslint",
    "docs/**/*.md": "node scripts/check-docs.mjs --",
    "AGENTS.md": "node scripts/check-docs.mjs --",
    "{src,server}/**/*.test.{ts,tsx,js}": "node scripts/check-tests.mjs --"
  }
}
